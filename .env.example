# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# OpenAI (required)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Langfuse observability (optional until tracing is wired)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Local FAISS persistence
FAISS_PATH=./data/faiss
FAISS_COLLECTION=finance_education

# App database (users, sessions, portfolios, goals)
APP_DB_PATH=./data/clarityfi.db

# Qdrant hybrid index (embedded local mode; set QDRANT_URL to use a server)
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=finance_education

# Sign-in: demo users learner-101..110 use DEMO_PASSWORD (blank = the documented default, see README). ADMIN_USER_IDS may upload knowledge files.
DEMO_LOGIN_ENABLED=
DEMO_PASSWORD=
ADMIN_USER_IDS=

# Read-only glossary database
GLOSSARY_DB_PATH=./data/glossary.db

# Retrieval and upload limits
RAG_TOP_K=3
MAX_UPLOAD_MB=25

# Web/news search (SerpAPI) and market-data fallback (Alpha Vantage)
SERPAPI_API_KEY=
ALPHAVANTAGE_API_KEY=

# LangSmith (optional). Runs are PII-masked before upload. Set ENABLE_LANGSMITH=true AND a key to turn it on.
ENABLE_LANGSMITH=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=clarityfi
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Password reset emails. "console" (default) logs the reset link instead of sending it — no external account
# needed for local dev. Set EMAIL_PROVIDER=ses (and SES_SENDER_EMAIL to a verified SES identity) to actually send.
APP_BASE_URL=http://127.0.0.1:5173
EMAIL_PROVIDER=console
SES_SENDER_EMAIL=
AWS_REGION=us-east-1
